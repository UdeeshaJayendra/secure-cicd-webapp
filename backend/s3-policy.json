{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListSecureOpsBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::secureops-file-storage-udeesha-2026"
    },
    {
      "Sid": "ManageSecureOpsObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::secureops-file-storage-udeesha-2026/*"
    }
  ]
}