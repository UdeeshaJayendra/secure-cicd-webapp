{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CodePipelineArtifactAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:PutObject",
        "s3:AbortMultipartUpload"
      ],
      "Resource": "arn:aws:s3:::secureops-codepipeline-artifacts-216453078762/*"
    },
    {
      "Sid": "CodePipelineArtifactBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketVersioning",
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::secureops-codepipeline-artifacts-216453078762"
    }
  ]
}
